rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Perfil do usuário logado (documento users/{uid}) ----
    function hasProfile() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function prof()       { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role()       { return hasProfile() ? prof().role : ''; }
    function isAdmin()    { return role() == 'admin'; }
    function isStaff()    { return role() in ['admin', 'igreja', 'leader']; }
    function inChurch(c)  { return role() == 'igreja' && prof().church == c; }   // líder de jovens da igreja
    function inCell(c)    { return role() == 'leader' && prof().cell == c; }     // líder de célula
    function inScope(d)   { return isAdmin() || inChurch(d.church) || inCell(d.cell); }

    // Usuários: cada um lê só o próprio perfil; só o admin cria/edita/exclui perfis
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Igrejas e líderes de igreja: leitura para quem tem perfil; escrita só admin
    match /churches/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /leaders/{id}  { allow read: if isStaff(); allow write: if isAdmin(); }

    // Células: admin vê todas; líder de igreja, as da sua igreja; líder de célula, só a sua
    match /cells/{id} {
      allow read: if isAdmin() || inChurch(resource.data.church) || inCell(resource.data.id);
      allow write: if isAdmin();
    }

    // Membros: lançam/editam dentro do próprio escopo; só o admin exclui
    match /members/{id} {
      allow read: if inScope(resource.data);
      allow create: if inScope(request.resource.data);
      allow update: if inScope(resource.data) && inScope(request.resource.data);
      allow delete: if isAdmin();
    }

    // Reuniões e visitas: leitura, criação, edição e exclusão dentro do próprio escopo
    match /meetings/{id} {
      allow read, delete: if inScope(resource.data);
      allow create: if inScope(request.resource.data);
      allow update: if inScope(resource.data) && inScope(request.resource.data);
    }
    match /visits/{id} {
      allow read, delete: if inScope(resource.data);
      allow create: if inScope(request.resource.data);
      allow update: if inScope(resource.data) && inScope(request.resource.data);
    }

    // Eventos: todos veem os gerais (church 0) e os da própria igreja; líderes criam só para a própria igreja
    match /events/{id} {
      allow read: if isStaff() && (isAdmin() || resource.data.church == 0 || resource.data.church == prof().church);
      allow create: if isAdmin() || (isStaff() && request.resource.data.church == prof().church
                                     && request.resource.data.by == request.auth.token.email);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.token.email);
    }

    // Financeiro: somente administrador
    match /finance/{id} { allow read, write: if isAdmin(); }

    // Todo o resto é negado
  }
}
